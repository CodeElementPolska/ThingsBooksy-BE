  "findings": [
    {
      "id": "architecture-guard-1-1",
      "file": "backend/src/Modules/ManagementGroups/ThingsBooksy.Modules.ManagementGroups.IntegrationTests/Clients/ManagementGroupsTestClient.cs",
      "line": 128,
      "severity": "OPINION",
      "type": "ARCHITECTURE",
      "message": "The ManagementGroups integration-test project reads the Resources module's tables directly with hard-coded raw SQL, so this story's table rename in the Resources module forced an edit in another module's tests. The pattern was already there and has no project or type reference, so the module-boundary rules in constitution#I and #IV (which are about module code) are not clearly broken. Still, every later physical rename in the Resources schema will break ManagementGroups tests silently, at runtime and not at compile time. Owner to consider whether cross-module cascade assertions should go through the owning module's API or a shared end-to-end test project instead.",
      "evidence": "ManagementGroupsTestClient.cs:106 `// --- Resources schema DB helpers (raw SQL — no cross-module type import) ---`; :128 `\"\"\"SELECT COUNT(1) FROM resources.resource_schemas WHERE \"GroupId\" = @groupId\"\"\"`; :140 `FROM resources.resource_instances`; DeleteManagementGroupTests.cs:89 `owner.Client.PostAsJsonAsync(\"/resources/schemas\", ...)`",
      "suggested_fix": "Optional: move the GroupDeleted cascade assertions into Resources.IntegrationTests, where the module owns its table names. Or add a cross-module end-to-end test project so one module's tests do not depend on another module's physical schema.",
      "rule_candidate": {
        "kind": "arch-test",
        "description": "Scan the source of each <Module>.IntegrationTests project for SQL string literals that name a schema other than the module's own snake_case schema (e.g. 'FROM resources.' inside ManagementGroups.IntegrationTests) and report them."
      }
    }
  ],
