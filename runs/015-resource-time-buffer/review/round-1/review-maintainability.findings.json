  "findings": [
    {
      "id": "review-maintainability-1-1",
      "file": "backend/src/Modules/Resources/ThingsBooksy.Modules.Resources.IntegrationTests/Clients/ResourcesTestClient.cs",
      "line": 175,
      "severity": "OPINION",
      "type": "MAINTAINABILITY",
      "message": "Two new DB helper methods are pure aliases of pre-existing methods with identical bodies: `GetResourceTypeFromDbIgnoringFiltersAsync` just calls `GetResourceTypeFromDbAsync` (which already applies `IgnoreQueryFilters()`), and `GetInstancesFromDbIgnoringFiltersAsync` (line 336-337) just calls `GetResourceInstancesByTypeFromDbAsync` (same behaviour). This gives the reader two names for the same query and invites drift if one is changed without the other. No written convention forbids this specific pattern, so it cannot be raised above OPINION, but it is duplication introduced by this diff.",
      "evidence": "ResourcesTestClient.cs:175-176: `internal Task<ResourceType?> GetResourceTypeFromDbIgnoringFiltersAsync(Guid id) => GetResourceTypeFromDbAsync(id);` — and the pre-existing GetResourceTypeFromDbAsync (line 161-168) already does `.IgnoreQueryFilters().FirstOrDefaultAsync(...)`. Same pattern at line 336-337 for GetInstancesFromDbIgnoringFiltersAsync / GetResourceInstancesByTypeFromDbAsync.",
      "suggested_fix": "Either rename the original methods to the `...IgnoringFiltersAsync` name (updating call sites) or delete the new aliases and call the original names directly from the new tests.",
      "rule_candidate": {
        "kind": "script",
        "description": "Flag newly added methods in a diff whose body is a single-expression delegate to a sibling method already defined in the same file/class (near-duplicate detector for test-client helper methods)."
      }
    }
  ],
